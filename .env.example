# Runtime
ENVIRONMENT=local
SUPPORT_DB_PATH=data/support.db
SUPPORT_DB_SEED_ENABLED=true

# Database upload
# Public users cannot upload or switch databases. Enable only for private admin maintenance.
DATABASE_UPLOAD_ENABLED=false
DATABASE_UPLOAD_PASSWORD=

# Langfuse tracing
LANGFUSE_TRACING_ENABLED=true
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
